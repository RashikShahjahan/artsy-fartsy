{
  "name": "artsy-fartsy",
  "version": "1.0.0",
  "description": "ArtCanvas drawing episodes with Liquid LFM2.5-230M and Pi Durable",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc && mkdir -p dist/docs dist/runtime && cp docs/*.md dist/docs/ && cp runtime/*.py dist/runtime/",
    "draw": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "serve": ".venv/bin/python -m uvicorn inference.server:app --host 127.0.0.1 --port 8080",
    "render": "node --import tsx src/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RashikShahjahan/artsy-fartsy.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/RashikShahjahan/artsy-fartsy/issues"
  },
  "homepage": "https://github.com/RashikShahjahan/artsy-fartsy#readme",
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  }
}
