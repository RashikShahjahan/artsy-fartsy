# Connect an Upstash Redis integration and a PRIVATE Vercel Blob store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace can supply KV_REST_API_URL / KV_REST_API_TOKEN instead.
BLOB_READ_WRITE_TOKEN=
# Custom Vercel Container Registry image built with client/sandbox/Dockerfile.
# Pin a digest so each job uses the reviewed agent/runtime version.
ARTSY_SANDBOX_IMAGE=
# Or use a prepared Vercel Sandbox snapshot (takes precedence over image).
ARTSY_SANDBOX_SNAPSHOT=
TINKER_API_KEY=
ARTSY_TINKER_MODEL_PATH=
# On Vercel, Sandbox uses automatic OIDC authentication.
# Local development: vercel link && vercel env pull .env.local
# External callers may instead set all three:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
