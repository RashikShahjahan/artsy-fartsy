# Dataset authors and evaluation/RL judges use GPT-6 Luna on OpenRouter.
OPENROUTER_API_KEY=your-openrouter-api-key
TINKER_API_KEY=your-tinker-api-key
# Dataset generation uses only the prompt writer and teacher; human review selects data.
ARTSY_PROMPT_MODEL=openai/gpt-6-luna
ARTSY_PROMPT_URL=https://openrouter.ai/api/v1
ARTSY_TEACHER_MODEL=openai/gpt-6-luna
ARTSY_TEACHER_URL=https://openrouter.ai/api/v1
# Correctness config is also used by the single adherence/visual-quality RL judge.
# Safety and code-safety judges below are used by evaluation only.
ARTSY_CORRECTNESS_JUDGE_MODEL=openai/gpt-6-luna
ARTSY_CORRECTNESS_JUDGE_URL=https://openrouter.ai/api/v1
ARTSY_SAFETY_JUDGE_MODEL=openai/gpt-6-luna
ARTSY_SAFETY_JUDGE_URL=https://openrouter.ai/api/v1
ARTSY_CODE_SAFETY_JUDGE_MODEL=openai/gpt-6-luna
ARTSY_CODE_SAFETY_JUDGE_URL=https://openrouter.ai/api/v1
ARTSY_BACKEND=tinker
# The model being trained/evaluated is independent of the authors and judges.
ARTSY_MODEL=Qwen/Qwen3.5-4B
# Local Kokoro speech. Install once with `make tts-setup`.
ARTSY_KOKORO_VOICE=af_heart
# Optional overrides: ARTSY_TTS_PYTHON, ARTSY_KOKORO_MODEL, ARTSY_KOKORO_VOICES.
