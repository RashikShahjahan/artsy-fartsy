# Dataset authors use GPT-6 Luna on OpenRouter; evaluation judges use Inkling on Tinker.
OPENROUTER_API_KEY=your-openrouter-api-key
TINKER_API_KEY=your-tinker-api-key
# Dataset generation uses only the prompt writer and teacher; human review selects data.
ARTSY_PROMPT_MODEL=openai/gpt-6-luna
ARTSY_PROMPT_URL=https://openrouter.ai/api/v1
ARTSY_TEACHER_MODEL=openai/gpt-6-luna
ARTSY_TEACHER_URL=https://openrouter.ai/api/v1
# These judge settings apply to evaluation, not dataset generation.
ARTSY_CORRECTNESS_JUDGE_MODEL=thinkingmachines/Inkling:peft:262144
ARTSY_CORRECTNESS_JUDGE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
ARTSY_SAFETY_JUDGE_MODEL=thinkingmachines/Inkling:peft:262144
ARTSY_SAFETY_JUDGE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
ARTSY_CODE_SAFETY_JUDGE_MODEL=thinkingmachines/Inkling:peft:262144
ARTSY_CODE_SAFETY_JUDGE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
ARTSY_BACKEND=tinker
# The model being trained/evaluated is independent of the authors and judges.
ARTSY_MODEL=Qwen/Qwen3.5-4B
